# Токен бота, отриманий від @BotFather
BOT_TOKEN=123456789:AAExampleTokenChangeMe

# Telegram ID адміністраторів через кому (дізнатись свій ID можна у @userinfobot)
ADMIN_IDS=111111111,222222222

# Реквізити для оплати, які бачить клієнт
PAYMENT_CARD=0000 0000 0000 0000
PAYMENT_IBAN=UA000000000000000000000000000

# Гаманець USDT (мережа TRC-20). Якщо не потрібен — залиште порожнім
PAYMENT_CRYPTO=

# Курс USDT до гривні. Якщо порожньо — бот сам бере офіційний курс НБУ (USD = USDT)
USDT_RATE=
# Надбавка до автоматичного курсу у відсотках (наприклад 1.5). 0 — без надбавки
USDT_MARKUP_PERCENT=0

# Юзернейм менеджера для кнопки "Зв'язок з менеджером"
MANAGER_USERNAME=jobin_manager

# Шлях до файлу бази даних SQLite
DB_PATH=jobin.db
